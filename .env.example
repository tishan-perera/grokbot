# Local environment template for the Personal AI Operating System.
# Copy to a gitignored .env on an approved machine.
# Every line here stays a comment. Names only. No values.

# Model and repository access
# XAI_API_KEY=
# GITHUB_TOKEN=

# Mailroom connectors
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Calendar
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Local queue data, if a desk keeps a working copy on disk
# OS_QUEUE_DATA_DIR=
